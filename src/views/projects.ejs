<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/new-project">Add a New Service Project</a></p>
            <% } %>


                <ul class="projects-list">
                    <% projects.forEach(project=> { %>
                        <li>
                            <!-- Title is now big and prominent -->
                            <strong class="project-title">
                                <a href="/project/<%= project.project_id %>">
                                    <%= project.title %>
                                </a>
                            </strong>

                            <!-- Organization and Date grouped together with smaller text -->
                            <div class="project-meta">
                                <span class="project-org">
                                    <%= project.organization_name %>
                                </span>
                                <span class="project-divider">•</span>
                                <span class="project-date">
                                    <%= project.date %>
                                </span>

                            </div>
                        </li>
                        <% }); %>
                </ul>
    </main>
    <%- include('partials/footer') %>