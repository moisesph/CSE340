<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= project.project_id %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input required type="text" value="<%= project.title %>" maxlength="150" id="title" name="title" />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea required maxlength="500" id="description"
                    name="description"><%= project.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input required type="text" id="location" name="location" maxlength="255"
                    value="<%= project.location %>" />
            </div>

            <div class="form-group">
                <label for="date">
                    Date
                </label>
                <input value="<%= project.date %>" type="date" id="date" name="date" required />
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select required id="organizationId" name="organizationId" required>
                    <option></option>
                    <% organizations.forEach(org=> { %>
                        <option value="<%= org.organization_id %>" <%=(project.organization_id===org.organization_id )
                            ? 'selected' : '' %>>
                            <%= org.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <button type="submit">Update Project</button>
        </form>

    </main>
    <%- include('partials/footer') %>