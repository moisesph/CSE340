<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Name: <%= name %>
        </p>
        <p>Username: <%= email %>
        </p>

        <% if (user && user.role_name==='admin' ) { %>
            <a href="/users">Show All Users</a>
            <% } %>

                <% if (user && user.role_name==='user' ) { %>
                    <% projects.forEach(project => { %>
                        <div>
                            <h3><%= project.title %></h3>
                            <p><%= project.description %></p>
                        </div>
                    <% }) %>
                    <% } %>

    </main>

    <%- include('partials/footer') %>