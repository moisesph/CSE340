<%- include('partials/header') %>

    <main class="users-view-main">
        <h1 class="users-title">
            <%= title %>
        </h1>

        <div class="dashboard-info">
            <p><strong>Name:</strong>
                <%= name %>
            </p>
            <p><strong>Username:</strong>
                <%= email %>
            </p>

            <% if (user && user.role_name==='admin' ) { %>
                <a href="/users" class="users-back-link">Show All Users</a>
                <% } %>
        </div>

        <% if (user && user.role_name==='user' ) { %>
            <ul class="projects-list">
                <% projects.forEach(project=> { %>
                    <li>
                        <h3 class="project-title">
                            <%= project.title %>
                        </h3>
                        <p class="project-meta-desc">
                            <%= project.description %>
                        </p>

                        <form method="POST" action="/dashboard/<%= project.project_id %>" class="form-actions">
                            <button type="submit" name="modifyBeVolunteer" value="removeInDashboard"
                                class="btn-base btn-remove">
                                Remove Enrollment
                            </button>
                        </form>
                    </li>
                    <% }) %>
            </ul>
            <% } %>
    </main>

    <%- include('partials/footer') %>