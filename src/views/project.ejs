<%- include('partials/header') %>
    <main>

        <div class="projects-list">

            <strong class="project-title">
                <%= project.title %>
            </strong>
            <span>
                <h2>Description</h2>
                <%= project.description %>
                    <%= project.location %>
            </span>
            <div class="project-meta">

                <span class="project-divider">•</span>

                <span class="project-org">
                    <p>Organization:
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>,
                    </p>
                </span>
                <span class="project-date">
                    <p>Date: <%= project.date %>
                    </p>
                </span>

            </div>
            <span>
                <h2>Categories</h2>
                <%= categories.category_id %>
                    <% categories.forEach(category=> { %>
                        <li>

                            <strong>
                                <a href="/category/<%= category.category_id %>">
                                    <%= category.name %>
                                </a>
                            </strong>
                            <% }); %>
                                </ul>
            </span>

        </div>
        <% if (user && user.role_name==='admin' ) { %>
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
            <% } %>
                <% if (user && user.role_name==='admin' ) { %>
                    <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
                    <% } %>
    </main>
    <%- include('partials/footer') %>