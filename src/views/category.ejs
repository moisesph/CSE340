<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <%= category.name %>
            <a href="/update-category/<%= category.category_id %>">Edit Category</a>
            <ul>
                <% projects.forEach(project=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </li>
                    <% }) %>
            </ul>

    </main>

    <%- include('partials/footer') %>