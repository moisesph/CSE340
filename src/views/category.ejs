<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <%= category.name %>

            <% if (user && user.role_name==='admin' ) { %>
                <a href="/update-category/<%= category.category_id %>">Edit Category</a>
                <% } %>

                    <ul>
                        <% projects.forEach(project=> { %>
                            <li>
                                <a href="/project/<%= project.project_id %>">
                                    <%= project.title %>
                                </a>
                            </li>
                            <% }) %>
                    </ul>

    </main>

    <%- include('partials/footer') %>