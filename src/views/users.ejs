<%- include('partials/header') %>
    <main class="users-view-main">
        <h1 class="users-title">
            <%= title %>
        </h1>

        <div class="users-list">
            <% users.forEach(user=> { %>
                <div class="user-card">
                    <p>Name: <%= user.name %>
                    </p>
                    <p>Email (username): <%= user.email %>
                    </p>
                    <p>Role: <%= user.role_name %>
                    </p>
                </div>
                <% }); %>
        </div>
    </main>
    <%- include('partials/footer') %>